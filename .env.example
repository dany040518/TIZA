# Supabase (required)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI key lives ONLY as a Supabase Edge Function secret — never in the frontend.
# Set it in the Supabase dashboard: Project Settings > Edge Functions > Secrets
# Secret name: OPENROUTER_API_KEY
# Optional: MODEL=<openrouter-model-id>  (default: qwen/qwen-2.5-72b-instruct)
